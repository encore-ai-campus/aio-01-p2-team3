APP_ENV=development
APP_TIMEZONE=Asia/Seoul
TEST_MODE=true

# Streamlit → FastAPI
BACKEND_API_URL=http://localhost:8000
# 백엔드 개발 전에는 true로 유지합니다. 준비 후 false로 바꾸면 실제 FastAPI를 호출합니다.
USE_MOCK_API=true
BACKEND_API_TIMEOUT_SECONDS=10

# PostgreSQL·Redis
POSTGRES_DSN=postgresql+psycopg://postgres:password@localhost:5432/baby_ai
REDIS_URL=redis://localhost:6379/0

# OpenAI Responses API·STT
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_VISION_MODEL=
STT_MODEL=gpt-4o-mini-transcribe

# MCP 서버
BABY_CARE_MCP_URL=http://localhost:8101
BABY_INFO_MCP_URL=http://localhost:8102

# Ollama Embedding
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_EMBEDDING_DIMENSION=768
OLLAMA_TIMEOUT_SECONDS=30
RAG_TOP_K=5
RAG_MIN_SIMILARITY=0.70

# 병원 공공데이터
PEDIATRIC_API_KEY=
EMERGENCY_API_KEY=
EXTERNAL_API_TIMEOUT_SECONDS=5
EXTERNAL_API_RETRY_COUNT=1

# 업로드 제한
MAX_IMAGE_SIZE_MB=10
MAX_AUDIO_SIZE_MB=20
IMAGE_TEMP_DIRECTORY=uploads
IMAGE_MAX_BYTES=10485760
IMAGE_MIN_WIDTH=224
IMAGE_MIN_HEIGHT=224
IMAGE_DARK_THRESHOLD=35
IMAGE_BRIGHT_THRESHOLD=235
IMAGE_BLUR_THRESHOLD=20
